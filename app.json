{
  "expo": {
    "name": "Courtly",
    "owner": "nugraharmd",
    "slug": "courtly-mobile-fmxbpbvintvhnzuxkzkj",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "courtly",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFE047",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "package": "com.courtly.app",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      [
        "expo-calendar",
        {
          "calendarPermission": "Courtly needs calendar access to save your court bookings."
        }
      ],
      "expo-image",
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F0C",
          "image": "./assets/images/splash.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "24677779-1de6-44e3-8937-cfd0bcbc8708"
      },
      "router": {}
    }
  }
}
